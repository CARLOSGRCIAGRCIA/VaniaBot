# ⚡ VARIABLES DE ENTORNO OPTIMIZADAS PARA VANIABOT

# ============================================
# 🔧 CONFIGURACIÓN BÁSICA
# ============================================

BOT_NAME=VaniaBot
PREFIX=!

# IDs de owners (separados por coma)
# Soporta: números simples, JIDs estándar, JIDs de canal
OWNERS=208924405956643@lid,529516526675
OWNER_JIDS=208924405956643@lid

# ============================================
# 📱 AUTENTICACIÓN
# ============================================

# Método de autenticación
# true = Código de pareamiento | false = Código QR
USE_PAIRING_CODE=true

# Número de teléfono (con código de país)
# Formato: +[código país][número]
# Ejemplo: +529514639799
PHONE_NUMBER=+529514639799

# Ruta de sesión
SESSION_PATH=./data/vaniasession

# ============================================
# ⚡ OPTIMIZACIONES DE CONEXIÓN
# ============================================

# Máximo de intentos de reconexión (optimizado: 10)
MAX_RECONNECT_ATTEMPTS=10

# Auto-reconexión automática
AUTO_RECONNECT=true

# ============================================
# 🗄️ BASE DE DATOS
# ============================================

# Tipo de base de datos: json | mongodb
DB_TYPE=json

# URI de MongoDB (solo si DB_TYPE=mongodb)
# DB_URI=mongodb://localhost:27017/vaniabot

# ============================================
# ⚡ CACHÉ Y RENDIMIENTO
# ============================================

# Habilitar sistema de caché en memoria
CACHE_ENABLED=true

# Anti-spam (middleware de rate limiting)
ANTI_SPAM=true

# ============================================
# 🌍 ENTORNO
# ============================================

# Entorno de ejecución
NODE_ENV=production

# ============================================
# 📊 CONFIGURACIÓN AVANZADA (Opcional)
# ============================================

# Nivel de logging (error | warn | info | debug)
LOG_LEVEL=info

# Timeout de conexión (ms) - Default: 90000
# CONNECTION_TIMEOUT=90000

# Intervalo de keep-alive (ms) - Default: 25000
# KEEP_ALIVE_INTERVAL=25000

# Delay de retry (ms) - Default: 200
# RETRY_DELAY=200

# Tamaño máximo de caché de DB - Default: 10000
# DB_CACHE_MAX_SIZE=10000

# Delay de guardado de DB (ms) - Default: 2000
# DB_SAVE_DELAY=2000

# Intervalo de guardado forzoso de DB (ms) - Default: 30000
# DB_FORCE_SAVE_INTERVAL=30000

# ============================================
# 🔐 SEGURIDAD
# ============================================

# Máximo de comandos por minuto por usuario
MAX_COMMANDS_PER_MINUTE=10

# Tamaño máximo de archivos multimedia (bytes)
# Default: 50MB = 52428800
MAX_MEDIA_SIZE=52428800

# ============================================
# 🎯 FUNCIONALIDADES
# ============================================

# Auto-leer mensajes
AUTO_READ=false

# Responder a mensajes propios
SELF_REPLY=false

# ============================================
# 📝 NOTAS
# ============================================

# IMPORTANTE:
# 1. Nunca compartas este archivo .env
# 2. Usa .env.example para compartir plantillas
# 3. Reinicia el bot después de cambiar variables
# 4. Las variables con # al inicio son opcionales

# OPTIMIZACIONES APLICADAS:
#  MAX_RECONNECT_ATTEMPTS aumentado de 5 a 10
#  AUTO_RECONNECT habilitado por defecto
#  CACHE_ENABLED habilitado por defecto
#  DB_TYPE=json optimizado con caché en memoria
#  Timeouts y delays ajustados para mejor rendimiento

# PARA REVERTIR OPTIMIZACIONES:
# Si experimentas problemas, puedes revertir a valores conservadores:
# MAX_RECONNECT_ATTEMPTS=5
# DB_CACHE_MAX_SIZE=5000
# DB_SAVE_DELAY=5000

# ============================================
# 🚀 INICIO RÁPIDO
# ============================================

# 1. Copia este archivo como .env
# 2. Ajusta BOT_NAME, OWNERS y PHONE_NUMBER
# 3. Ejecuta: npm start
# 4. Escanea QR o ingresa código de pareamiento
# 5. ¡Listo!

# ============================================
# 📚 RECURSOS
# ============================================

# Documentación completa: Ver OPTIMIZACIONES.md
# Troubleshooting: Ver sección correspondiente en OPTIMIZACIONES.md
# Soporte: Contacta al desarrollador

# ============================================
# 🎉 ¡DISFRUTA TU BOT OPTIMIZADO!
# ============================================
