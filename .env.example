BOT_NAME=VaniaBot
BOT_PREFIX=.

# IDs de owners (separados por coma)
# Soporta: números simples, JIDs estándar, JIDs de canal
# ⚠️ REEMPLAZA con tus propios IDs de WhatsApp
OWNERS=tu_numero_o_jid_aqui
OWNER_JIDS=tu_numero_o_jid_aqui

# Método de autenticación
# true = Código de pareamiento | false = Código QR
USE_PAIRING_CODE=true

# Número de teléfono (con código de país)
# Formato: +[código país][número]
# ⚠️ REEMPLAZA con tu número de WhatsApp
PHONE_NUMBER=+5215512345678

# Ruta de sesión
SESSION_PATH=./vaniasession

# Máximo de intentos de reconexión (optimizado: 10)
MAX_RECONNECT_ATTEMPTS=10

# Auto-reconexión automática
AUTO_RECONNECT=true

# Tipo de base de datos: json | sqlite | mongodb
DB_TYPE=sqlite

# URI de MongoDB (solo si DB_TYPE=mongodb)
# DB_URI=mongodb://localhost:27017/vaniabot

# Ruta de base de datos SQLite (solo si DB_TYPE=sqlite)
# DB_PATH=./data/vaniabot.db

# Habilitar sistema de caché en memoria
CACHE_ENABLED=true

# Anti-spam (middleware de rate limiting)
ANTI_SPAM=true

# Entorno de ejecución
NODE_ENV=production

# Nivel de logging (error | warn | info | debug)
LOG_LEVEL=info

# Timeout de conexión (ms) - Default: 90000
# CONNECTION_TIMEOUT=90000

# Intervalo de keep-alive (ms) - Default: 25000
# KEEP_ALIVE_INTERVAL=25000

# Delay de retry (ms) - Default: 200
# RETRY_DELAY=200

# Tamaño máximo de caché de DB - Default: 10000
# DB_CACHE_MAX_SIZE=10000

# Delay de guardado de DB (ms) - Default: 2000
# DB_SAVE_DELAY=2000

# Intervalo de guardado forzoso de DB (ms) - Default: 30000
# DB_FORCE_SAVE_INTERVAL=30000

# Máximo de comandos por minuto por usuario
MAX_COMMANDS_PER_MINUTE=10

# Tamaño máximo de archivos multimedia (bytes)
# Default: 50MB = 52428800
MAX_MEDIA_SIZE=52428800

# Auto-leer mensajes
AUTO_READ=false

# Responder a mensajes propios
SELF_REPLY=false

# === AI Configuration ===
# Groq API key (required for AI features, get free at https://console.groq.com/keys)
GROQ_API_KEY=groq_api_key

# Gemini API key for AI fallback (optional, get free at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=tu_gemini_api_key

# Ollama URL for local AI fallback (optional, default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Redis configuration (optional, for Docker environments)
# USE_REDIS=true
# REDIS_URL=redis://redis:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Groq AI API (get free at https://console.groq.com/keys)
# GROQ_API_KEY=tu_api_key_aqui

# DeepAI API (get at https://deepai.org)
# DEEPAI_API_KEY=tu_api_key_aqui

# Restart configuration (vania.ts)
# MAX_QUICK_RESTARTS=5
# RESTART_WINDOW_MS=120000
# MAX_RESTART_DELAY_MS=30000
# FORCE_RESTART_WAIT_MS=60000

# Rate limiting
# MAX_COMMANDS_PER_MINUTE=10
# GROUP_RATE_LIMIT_MAX_MESSAGES=30
# GROUP_RATE_LIMIT_WINDOW_MS=60000
# FLOOD_MAX_MESSAGES_PER_SECOND=3
# FLOOD_WINDOW_MS=1000

# 1. Copia este archivo como .env
# 2. Ajusta BOT_NAME, OWNERS y PHONE_NUMBER
# 3. Ejecuta: npm start
# 4. Escanea QR o ingresa código de pareamiento
# 5. ¡Listo!

# Documentación completa: Ver Readme.md
# Contribuciones: Ver CONTRIBUTING.md
# Soporte: Contacta al desarrollador
